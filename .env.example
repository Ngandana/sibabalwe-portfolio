# Template only — NEVER put real keys in this file, it gets committed to git.
# Copy it to .env.local (gitignored) and fill in the real values there.
# In production, set these in the Vercel project's Environment Variables instead.
# See README.md → "Setting up the AI assistant" for where to get each one.

GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — defaults to gemini-3.5-flash-lite. Set this if that model is ever
# retired, so you can swap models without changing code.
GEMINI_MODEL=

# Optional — see README "Seeing what visitors ask". Logs conversations to
# Supabase so you can review them. Leave both blank to keep logging off.
# SUPABASE_SERVICE_ROLE_KEY is a server-only secret (used in api/_lib/chatlog.js,
# never shipped to the browser) — do NOT use the anon/public key here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
